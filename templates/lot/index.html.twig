{% extends 'base.html.twig' %}

{% block title %}Lot index{% endblock %}

{% block body %}
    <h1>Lot index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Reference</th>
                <th>DateEntree</th>
                <th>NombreInitial</th>
                <th>CreatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for lot in lots %}
            <tr>
                <td>{{ lot.id }}</td>
                <td>{{ lot.reference }}</td>
                <td>{{ lot.dateEntree ? lot.dateEntree|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ lot.nombreInitial }}</td>
                <td>{{ lot.createdAt ? lot.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_lot_show', {'id': lot.id}) }}">show</a>
                    <a href="{{ path('app_lot_edit', {'id': lot.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_lot_new') }}">Create new</a>
{% endblock %}
