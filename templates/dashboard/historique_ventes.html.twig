{% extends 'base.html.twig' %}

{% block title %}Historique Ventes Lot {{ lot.reference }}{% endblock %}

{% block body %}
<h1>Historique des ventes pour le lot {{ lot.reference }}</h1>

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>Date</th>
            <th>Nombre vendu</th>
            <th>Prix unitaire (€)</th>
            <th>Total (€)</th>
        </tr>
    </thead>
    <tbody>
        {% for vente in ventes %}
            <tr>
                <td>{{ vente.date ? vente.date|date('Y-m-d H:i') : '' }}</td>
                <td>{{ vente.nombre }}</td>
                <td>{{ vente.prixUnitaire|number_format(2, ',', ' ') }}</td>
                <td>{{ (vente.nombre * vente.prixUnitaire)|number_format(2, ',', ' ') }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucune vente enregistrée pour ce lot.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<a href="{{ path('dashboard') }}">Retour au dashboard</a>
{% endblock %}
