{% extends 'base.html.twig' %}

{% block title %}Mortalite{% endblock %}

{% block body %}
    <h1>Mortalite</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ mortalite.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ mortalite.nombre }}</td>
            </tr>
            <tr>
                <th>Cause</th>
                <td>{{ mortalite.cause }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ mortalite.date ? mortalite.date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_mortalite_index') }}">back to list</a>

    <a href="{{ path('app_mortalite_edit', {'id': mortalite.id}) }}">edit</a>

    {{ include('mortalite/_delete_form.html.twig') }}
{% endblock %}
