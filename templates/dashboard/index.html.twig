{% extends 'base.html.twig' %}

{% block title %}Dashboard Poulets{% endblock %}

{% block body %}
<h1>Dashboard Poulets</h1>

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>Référence Lot</th>
            <th>Date Entrée</th>
            <th>Nombre Initial</th>
            <th>Morts</th>
            <th>Vendus</th>
            <th>Stock Vivant</th>
            <th>Somme Ventes (€)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for lotData in lotsData %}
            <tr>
                <td>{{ lotData.lot.reference }}</td>
                <td>{{ lotData.lot.dateEntree|date('Y-m-d') }}</td>
                <td>{{ lotData.lot.nombreInitial }}</td>
                <td>{{ lotData.morts }}</td>
                <td>{{ lotData.vendus }}</td>
                <td>{{ lotData.stockVivant }}</td>
                <td>{{ lotData.sommeVentes|number_format(2, ',', ' ') }}</td>
                <td>
                    <a href="{{ path('ajouter_mortalite', {'id': lotData.lot.id}) }}">Ajouter mortalité</a> |
                    <a href="{{ path('ajouter_vente', {'id': lotData.lot.id}) }}">Ajouter vente</a> |
                    <a href="{{ path('historique_ventes', {'id': lotData.lot.id}) }}">Voir historique</a>
                </td>
            </tr>
        {% endfor %}
        <tr>
            <td colspan="6" style="text-align:right"><strong>Total général :</strong></td>
            <td colspan="2"><strong>{{ totalGeneral|number_format(2, ',', ' ') }} €</strong></td>
        </tr>
    </tbody>
</table>
{% endblock %}
