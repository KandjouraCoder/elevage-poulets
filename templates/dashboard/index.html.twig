{% extends 'base.html.twig' %}

{% block title %}Dashboard Poulets{% endblock %}

{% block body %}
<h1>Dashboard Poulets</h1>

{% for message in app.flashes('success') %}
    <div style="color:green;">{{ message }}</div>
{% endfor %}

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>Référence Lot</th>
            <th>Date Entrée</th>
            <th>Nombre Initial</th>
            <th>Morts</th>
            <th>Vendus</th>
            <th>Stock Vivant</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for row in lotsData %}
            <tr>
                <td>{{ row.lot.reference }}</td>
                <td>{{ row.lot.dateEntree|date('Y-m-d') }}</td>
                <td>{{ row.lot.nombreInitial }}</td>
                <td>{{ row.morts }}</td>
                <td>{{ row.vendus }}</td>
                <td>{{ row.stockVivant }}</td>
                <td>
                    <a href="{{ path('ajouter_mortalite', {'id': row.lot.id}) }}">
                        <button>Ajouter Mort</button>
                    </a>
                    <a href="{{ path('ajouter_vente', {'id': row.lot.id}) }}">
                        <button>Ajouter Vente</button>
                    </a>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
